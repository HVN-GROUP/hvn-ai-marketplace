# TLS tự động. Không ghi IP, URL hay header của người dùng:
# - không bật access log;
# - loại log lỗi HTTP và log reverse proxy (các log này chứa remote_ip và header).
# Giới hạn request theo kênh nằm trong ứng dụng (server/app.ts).
{
	log default {
		exclude http.log.error http.handlers.reverse_proxy
	}
}

{$MCP_DOMAIN} {
	encode gzip
	reverse_proxy mcp:3000
}
